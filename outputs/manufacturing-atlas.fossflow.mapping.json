      "scene_id": "release-delivery",
      "fossflow_item_id": "release-delivery",
      "fossflow_icon_id": "art-release-delivery",
      "title": "放行与交付",
      "description": "检验人员核对待交付批次和放行证据，出货工位展示通过评估后的货物准备。",
      "cases": [
        {
          "id": "case-17",
          "title": "交付风险评估",
          "roles": "生产",
          "description": "出货前查出异常，难不在判定合格与否，而在能不能放、不能放有无别的路，拍板信息不在品质工程师手上",
          "source_refs": [
            "source-case-17"
          ]
        },
        {
          "id": "case-31",
          "title": "放行前法定十项齐套性与缺口清单",
          "roles": "生产",
          "description": "法规要求放行前逐项确认十项，这十项的证据散在 47 页手写批记录和四个部门手中",
          "source_refs": [
            "source-case-31"
          ]
        },
        {
          "id": "case-32",
          "title": "放行前追溯码专项核对清单",
          "roles": "生产",
          "description": "法规要求 QP 确认「各级销售单元均已赋码并做好信息关联」，而他手中没有任何文件能证明此事",
          "source_refs": [
            "source-case-32"
          ]
        },
        {
          "id": "case-20",
          "title": "作废码与物料平衡逐条对账",
          "roles": "生产",
          "description": "物料平衡 100.00% 闭合，纸面无懈可击，但有 3 个应作废的码此刻仍为「已关联」状态",
          "source_refs": [
            "source-case-20"
          ]
        },
        {
          "id": "case-38",
          "title": "追溯码上传成功确认台账",
          "roles": "生产",
          "description": "导出成功不等于上传成功，而上传是否成功，厂里没有任何人被指定负责",
          "source_refs": [
            "source-case-38"
          ]
        },
        {
          "id": "case-48",
          "title": "并网收资清单缺项核查",
          "roles": "运营 · 法务",
          "description": "十一份资料交了十份，电网答复缺一份、回去等通知，等待的每一天，违约金按合同总价累进",
          "source_refs": [
            "source-case-48"
          ]
        },
        {
          "id": "case-49",
          "title": "竣工资料归档缺口核查",
          "roles": "运营",
          "description": "竣工验收那天资料箱是满的，两年后索赔要用时，才发现关键几页从未进过箱子",
          "source_refs": [
            "source-case-49"
          ]
        }
      ],
