      "scene_id": "production-quality",
      "fossflow_item_id": "production-quality",
      "fossflow_icon_id": "art-production-quality",
      "title": "生产与质检",
      "description": "加工区核查开工条件并处理工件，检验区查看样品和良率记录。设备与工位是便于理解的示意，具体案例来自原图。",
      "cases": [
        {
          "id": "case-13",
          "title": "开工条件核查",
          "roles": "生产 · PMC · 采购",
          "description": "开工确认易带病开工，需跨五个部门逐一确认，几小时才能凑齐答案",
          "source_refs": [
            "source-case-13"
          ]
        },
        {
          "id": "case-5",
          "title": "执行偏差追踪与补产",
          "roles": "PMC",
          "description": "跟单难不在算完成率，而在报工数据不可信、进度显示失真、根因证据散在其他部门",
          "source_refs": [
            "source-case-5"
          ]
        },
        {
          "id": "case-18",
          "title": "交接班「十交清」日志草稿",
          "roles": "生产",
          "description": "记录本上每一栏均已填写，唯独最该写的第三项「异常指标详细工况」长期空白",
          "source_refs": [
            "source-case-18"
          ]
        },
        {
          "id": "case-14",
          "title": "CP／FT 良率日报",
          "roles": "生产",
          "description": "日报天天都在出，只报当天数据，无人与三周前的基线对比",
          "source_refs": [
            "source-case-14"
          ]
        },
        {
          "id": "case-19",
          "title": "低良批次初判快报",
          "roles": "生产",
          "description": "低良批次人人都在救，初判全靠资深工程师看 map 猜，离职即经验清零",
          "source_refs": [
            "source-case-19"
          ]
        },
        {
          "id": "case-23",
          "title": "品质异常分析",
          "roles": "生产",
          "description": "品质分析难不在把报告写满，而在有限时间内把根因追到可整改那一层，答清为何没检出来",
          "source_refs": [
            "source-case-23"
          ]
        },
        {
          "id": "case-29",
          "title": "报废归因帕累托周报",
          "roles": "生产",
          "description": "报废记录人人都在做，客户资料问题混入制程问题，损失无法归因到客户",
          "source_refs": [
            "source-case-29"
          ]
        },
        {
          "id": "case-30",
          "title": "收率连续同向偏移的趋势体检",
          "roles": "生产",
          "description": "每一批收率都在内控限以内，六批连起来看却是一条直线持续下滑",
          "source_refs": [
            "source-case-30"
          ]
        },
        {
          "id": "case-35",
          "title": "电芯批次测试报告成稿",
          "roles": "生产",
          "description": "分容柜一晚跑完两千多只电芯，报告却要一人对 Excel 拉到天亮，决定能否发货的那一行从不在报表模板里",
          "source_refs": [
            "source-case-35"
          ]
        },
        {
          "id": "case-36",
          "title": "良率周报与措施闭环",
          "roles": "生产",
          "description": "周报中改善措施罗列整齐，从未验证过往措施是否真正有效",
          "source_refs": [
            "source-case-36"
          ]
        }
      ],
