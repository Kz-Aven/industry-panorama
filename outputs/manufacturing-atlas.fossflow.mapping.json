    {
      "scene_id": "planning-supply",
      "fossflow_item_id": "planning-supply",
      "fossflow_icon_id": "art-planning-supply",
      "title": "计划与供应",
      "description": "PMC 与采购查看排产板和清单，协调缺料、到货与插单影响。",
      "cases": [
        {
          "id": "case-3",
          "title": "交期平衡与产销协同",
          "roles": "PMC",
          "description": "PMC 排产难不在排表，而在多单挤一条产线时先保谁缺乏标准，销售生产物料拉会半天口径仍不一",
          "source_refs": [
            "source-case-3"
          ]
        },
        {
          "id": "case-6",
          "title": "排产与插单调整",
          "roles": "PMC",
          "description": "插单难不在调整优先级这一个动作，而在改完现场不知道、通知没回执、过程没留痕",
          "source_refs": [
            "source-case-6"
          ]
        },
        {
          "id": "case-7",
          "title": "齐套与缺料预警",
          "roles": "PMC",
          "description": "齐套难不在 BOM 展开，而在可用库存口径算不准、判据散在 ERP 之外、缺料到开工时才暴露",
          "source_refs": [
            "source-case-7"
          ]
        },
        {
          "id": "case-59",
          "title": "来料跟催",
          "roles": "采购",
          "description": "采购每天盯十几张在途单，问题不在不催，而在按逾期天数排序催错顺序，真正卡交付的那张排最后",
          "source_refs": [
            "source-case-59"
          ]
        },
        {
          "id": "case-61",
          "title": "逾期订单风险日报（给老板版）",
          "roles": "采购",
          "description": "老板娘以为货都正常，直到产线等料停了半小时，才知道三张订单已逾期一周",
          "source_refs": [
            "source-case-61"
          ]
        },
        {
          "id": "case-53",
          "title": "EOL／PCN 影响评估",
          "roles": "采购",
          "description": "停产通知人人都在收，从通知到确定哪些订单要停、哪些料可切，缺乏对应表",
          "source_refs": [
            "source-case-53"
          ]
        },
        {
          "id": "case-57",
          "title": "单一来源风险清单",
          "roles": "采购",
          "description": "库存只够 7 天，更换供应商要 15 天，两个数字从未放在同一张表上",
          "source_refs": [
            "source-case-57"
          ]
        },
        {
          "id": "case-60",
          "title": "物料风险周快报",
          "roles": "采购",
          "description": "风险消息人人都在传，涨价具体影响自家哪颗料，无人逐条比对",
          "source_refs": [
            "source-case-60"
          ]
        },
        {
          "id": "case-55",
          "title": "供应商资质证书台账与到期监控",
          "roles": "采购",
          "description": "客户审厂前一天才发现核心供应商 ISO 证书上月已过期，补办要 20 天",
          "source_refs": [
            "source-case-55"
          ]
        },
        {
          "id": "case-50",
          "title": "供应商 COA 与进厂复检偏差台账",
          "roles": "采购 · 生产",
          "description": "供应商送样检测合格，到货批次的杂质含量却是送样的八百倍",
          "source_refs": [
            "source-case-50"
          ]
        },
        {
          "id": "case-51",
          "title": "来料检验与批次一致性异常识别",
          "roles": "采购 · 生产",
          "description": "供应商 COC 上每一项都合格，问题不在那张纸上，而在无人将它与外包装标签核对一遍",
          "source_refs": [
            "source-case-51"
          ]
        },
        {
          "id": "case-56",
          "title": "到货异常处理单与特采决策留痕",
          "roles": "采购",
          "description": "让步接收多为口头决定，三个月后批量质量问题追责时，说不清当时谁同意的",
          "source_refs": [
            "source-case-56"
          ]
        },
        {
          "id": "case-58",
          "title": "来料异常与假料风险比对",
          "roles": "采购",
          "description": "每颗来料均经过检验，假料与串料问题恰恰出在已验过的批次",
          "source_refs": [
            "source-case-58"
          ]
        },
        {
          "id": "case-1",
          "title": "呆滞料预警清单（库龄分档）",
          "roles": "PMC · 采购",
          "description": "860 万库存中有 96 万呆滞料无人动用，在财务月报中仅为一个周转率数字",
          "source_refs": [
            "source-case-1"
          ]
        },
        {
          "id": "case-4",
          "title": "库存结构与呆滞料复盘",
          "roles": "PMC",
          "description": "呆滞料复盘难不在拉库龄表，而在能否转用的判据不在 ERP、处置只剩报废、判据随人离职失传",
          "source_refs": [
            "source-case-4"
          ]
        }
      ],
