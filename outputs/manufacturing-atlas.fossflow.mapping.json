        },
        {
          "id": "case-34",
          "title": "模拟召回演练陪练与缺口清单",
          "roles": "生产",
          "description": "演练报告年年都有，结论年年都是「有效」，行业内部称之为「闭门造车」",
          "source_refs": [
            "source-case-34"
          ]
        },
        {
          "id": "case-54",
          "title": "供应商质量损失索赔台账",
          "roles": "采购",
          "description": "记得某供应商去年造成三万七损失，口头总账拿不出任何单据依据",
          "source_refs": [
            "source-case-54"
          ]
        },
        {
          "id": "case-8",
          "title": "质保索赔证据包",
          "roles": "技术支持 · 客服 · 法务",
          "description": "索赔谈判桌上最贵的不是那 450 万，而是对方发现你数据缺了四个月时，解释不清的那三分钟",
          "source_refs": [
