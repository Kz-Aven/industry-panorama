  "scenes": [
    {
      "scene_id": "sales-order",
      "fossflow_item_id": "sales-order",
      "fossflow_icon_id": "art-sales-order",
      "title": "商机与接单",
      "description": "商务人员与计划员在桌边核对客户订单、物料、产能和在制工单，形成接单建议。",
      "cases": [
        {
          "id": "case-63",
          "title": "图纸询价智能报价",
          "roles": "销售",
          "description": "报价慢且报价不准，根因不在算得慢，而在算之前需花大量时间凑齐图纸、历史件、材料价与工时依据",
          "source_refs": [
            "source-case-63"
          ]
        },
        {
          "id": "case-65",
          "title": "投标资格符合性自检",
          "roles": "销售",
          "description": "整本标书一千多页，被否原因往往只有一行，而这一行从来不在投标台账的列里",
          "source_refs": [
            "source-case-65"
          ]
        },
        {
          "id": "case-66",
          "title": "认证与检测报告条款符合性核对",
          "roles": "销售",
          "description": "证书在手、报告在柜、均在有效期内，招标要求的那一条，恰好不在其覆盖范围内",
          "source_refs": [
            "source-case-66"
          ]
        },
        {
          "id": "case-62",
          "title": "合同条款确认",
          "roles": "销售 · 法务",
          "description": "合同审查难点不在读不懂条款，而在缺少标准模板参照、条款组合易看漏、历史旧账长期无人复核",
          "source_refs": [
            "source-case-62"
          ]
        },
        {
          "id": "case-25",
          "title": "客户资料完整性预检",
          "roles": "生产",
          "description": "资料接收人人都在做，缺文件是 CAM hold 的首因，缺项永远在客户侧",
          "source_refs": [
            "source-case-25"
          ]
        },
        {
          "id": "case-64",
          "title": "客户单据转订单",
          "roles": "销售",
          "description": "客户 Excel/邮件/图片 口径格式不一，料号有五种混乱形态，单位按套按件算错即 4 倍差价",
          "source_refs": [
            "source-case-64"
          ]
        },
        {
          "id": "case-2",
          "title": "订单接单评审",
          "roles": "PMC · 销售",
          "description": "急单评审难不在算一道题，而在销售、技术、采购、生产、品质多方接力确认，跨 ERP / MES / APS 等系统来回切换仍未必答得准",
          "source_refs": [
            "source-case-2"
          ]
        }
      ],
      "sources": [
