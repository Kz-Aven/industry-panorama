    {
      "scene_id": "product-process",
      "fossflow_item_id": "product-process",
      "fossflow_icon_id": "art-product-process",
      "title": "产品与工艺",
      "description": "工程人员在工位核对 BOM 版本、变更记录和受影响订单。",
      "cases": [
        {
          "id": "case-43",
          "title": "竞品拆解 BOM 初稿",
          "roles": "研发",
          "description": "竞品拆解人人都在做，照片留存于个人目录，成本差异停留在感觉层面",
          "source_refs": [
            "source-case-43"
          ]
        },
        {
          "id": "case-40",
          "title": "BOM导入核对",
          "roles": "研发",
          "description": "BOM 导入的风险不在哪几行变了，而在异常差异与存量脏数据被一并带入新基线，牵动一批工单",
          "source_refs": [
            "source-case-40"
          ]
        },
        {
          "id": "case-52",
          "title": "BOM 脏数据清洗与一物多码归并",
          "roles": "采购",
          "description": "同一颗气缸在系统中有两个名称，重复下单、分存两处、盘点对不上",
          "source_refs": [
            "source-case-52"
          ]
        },
        {
          "id": "case-41",
          "title": "工程变更管理ECN",
          "roles": "研发",
          "description": "工程变更难点不在填表，而在影响面靠经验翻查、分级靠人判、会签周期长、整套文件需同步更新",
          "source_refs": [
            "source-case-41"
          ]
        },
        {
          "id": "case-42",
          "title": "替代料验证计划与风险台账",
          "roles": "研发",
          "description": "替代料搜寻每天都在进行，历史验证记录与失败原因留存于离职同事电脑",
          "source_refs": [
            "source-case-42"
          ]
        },
        {
          "id": "case-39",
          "title": "版本一致性巡检",
          "roles": "研发 · 生产 · PMC",
          "description": "系统里改了，现场还在用老版，人工抽查一星期跑不完上百份受控文件",
          "source_refs": [
            "source-case-39"
          ]
        },
        {
          "id": "case-15",
          "title": "SOP生成与校验",
          "roles": "生产",
          "description": "SOP 问题表面只是文档未更新，实际同时影响品质稳定性、工艺一致性与审核合规",
          "source_refs": [
            "source-case-15"
          ]
        },
        {
          "id": "case-16",
          "title": "三份文件工艺指标一致性核对",
          "roles": "生产",
          "description": "操作规程、工艺卡片、DCS 报警值三份文件各自写着一个上限，法律要求三者必须一致",
          "source_refs": [
            "source-case-16"
          ]
        }
      ],
