      "id": "roles",
      "title": "岗位协作图",
      "heading": "一张急单如何跨岗推进",
      "sections": [
        {
          "title": "按交接顺序",
          "entries": [
            {
              "label": "整理客户需求",
              "participant": "销售",
              "description": "客户单据 → 订单行、数量、期望交期"
            },
            {
              "label": "订单接单评审",
              "participant": "销售 · PMC",
              "description": "订单、齐套、产能、在制 → 接单建议与协调事项"
            },
            {
              "label": "排产与插单调整",
              "participant": "PMC",
              "description": "确认优先级、受影响工单与调整方案 → 更新后的排程"
            },
            {
              "label": "齐套预警与来料跟催",
              "participant": "PMC ⇄ 采购",
              "description": "缺料项与断料时间 → 到货预测、优先跟催清单"
            },
            {
              "label": "开工条件核查",
              "participant": "生产 · PMC · 采购",
              "description": "物料与现场准备状态 → 开工判断依据、待处理项"
            },
            {
              "label": "执行偏差追踪与补产",
              "participant": "生产 ⇄ PMC",
              "description": "工单与报工 → 偏差、补产建议、预计完成时间"
            },
            {
              "label": "交付风险评估与沟通",
              "participant": "生产 · PMC · 销售",
              "description": "异常批次、交期影响、备选方案 → 对客交期口径"
            }
          ]
        }
      ],
      "note": "↶ 到货延期或产能冲突时，回到排产与交期平衡\n岗位和交接关系为示意，实际分工随工厂而异。",
      "source_refs": [
        "manufacturing-roles"
      ]
    }
  ]
