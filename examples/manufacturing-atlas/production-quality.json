        "source_refs": [
          "source-case-14"
        ]
      },
      {
        "id": "case-19",
        "title": "低良批次初判快报",
        "roles": "生产",
        "description": "低良批次人人都在救，初判全靠资深工程师看 map 猜，离职即经验清零",
        "source_refs": [
          "source-case-19"
        ]
      },
      {
        "id": "case-23",
        "title": "品质异常分析",
        "roles": "生产",
        "description": "品质分析难不在把报告写满，而在有限时间内把根因追到可整改那一层，答清为何没检出来",
        "source_refs": [
          "source-case-23"
        ]
      },
      {
        "id": "case-29",
        "title": "报废归因帕累托周报",
        "roles": "生产",
        "description": "报废记录人人都在做，客户资料问题混入制程问题，损失无法归因到客户",
        "source_refs": [
          "source-case-29"
        ]
      },
      {
        "id": "case-30",
        "title": "收率连续同向偏移的趋势体检",
