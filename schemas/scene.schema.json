{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scene.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "type": {
      "enum": [
        "industry_atlas",
        "role_atlas",
        "process_journey",
        "scenario_diorama",
        "ai_opportunity_map"
      ]
    },
    "industry": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "semantic": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "$ref": "scene.schema.json#/definitions/entity"
          },
          "minItems": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "scene.schema.json#/definitions/action"
          },
          "minItems": 1
        },
        "business_objects": {
          "type": "array",
          "items": {
            "$ref": "scene.schema.json#/definitions/entity"
          },
          "minItems": 1
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "scene.schema.json#/definitions/entity"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "scene.schema.json#/definitions/source"
          },
          "minItems": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "scene.schema.json#/definitions/relation"
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "scene.schema.json#/definitions/case"
          }
        }
      },
      "required": [
        "roles",
        "actions",
        "business_objects",
        "systems",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "platform": {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "asset_id",
            "size",
            "height"
          ],
          "additionalProperties": false
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "scene.schema.json#/definitions/object"
          },
          "minItems": 2
        }
      },
      "required": [
        "template",
        "platform",
        "objects"
      ],
      "additionalProperties": false
    },
    "interaction": {
      "$ref": "scene.schema.json#/definitions/interaction"
    },
    "render": {
      "type": "object",
      "properties": {
        "style_profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "show_labels": {
          "type": "boolean"
        },
        "illustration": {
          "type": "string",
          "pattern": "^assets/illustrations/[a-z0-9_-]+[.]png$"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "industry",
    "title",
    "description",
    "semantic",
    "scene",
    "interaction",
    "render"
  ],
  "additionalProperties": false,
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "type": {
      "enum": [
        "industry_atlas",
        "role_atlas",
        "process_journey",
        "scenario_diorama",
        "ai_opportunity_map"
      ]
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "locator"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "roles",
        "description",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "label"
      ],
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "properties": {
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "output": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "required": [
        "id",
        "label",
        "actor",
        "target"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "slot": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "support": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "semantic_ref": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "interaction": {
          "$ref": "scene.schema.json#/definitions/interaction"
        }
      },
      "required": [
        "id",
        "asset_id"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "position",
          "slot"
        ]
      }
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "direction": {
      "enum": [
        0,
        90,
        180,
        270
      ]
    }
  }
}
