{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asset.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "version": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "enum": [
          "person",
          "furniture",
          "electronics",
          "document",
          "building",
          "vehicle",
          "platform",
          "accessory",
          "equipment",
          "material",
          "tool",
          "action"
        ]
      },
      "industry": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "file": {
        "type": "string",
        "pattern": "^assets/(?:[a-zA-Z0-9_-][a-zA-Z0-9._-]*/)*[a-zA-Z0-9_-][a-zA-Z0-9._-]*\\.(?:svg|png)$"
      },
      "footprint": {
        "type": "array",
        "items": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minItems": 2,
        "maxItems": 2
      },
      "height": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "anchor": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "supported_directions": {
        "type": "array",
        "items": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "style_profile": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "source_type": {
        "enum": [
          "local",
          "procedural",
          "external",
          "imagegen",
          "blender"
        ]
      },
      "source_prompt": {
        "type": "string",
        "minLength": 1
      },
      "source_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "license": {
        "type": "string",
        "minLength": 1
      },
      "attribution": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "enum": [
          "approved",
          "draft"
        ]
      },
      "surface_height": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "colors": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "variants": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "0",
            "90",
            "180",
            "270"
          ]
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^assets/(?:[a-zA-Z0-9_-][a-zA-Z0-9._-]*/)*[a-zA-Z0-9_-][a-zA-Z0-9._-]*\\.(?:svg|png)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "anchor": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "view_box": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "file",
            "sha256",
            "anchor",
            "view_box"
          ],
          "additionalProperties": false
        },
        "minProperties": 1
      }
    },
    "required": [
      "id",
      "version",
      "name",
      "category",
      "industry",
      "tags",
      "aliases",
      "file",
      "footprint",
      "height",
      "anchor",
      "supported_directions",
      "style_profile",
      "source_type",
      "source_url",
      "license",
      "attribution",
      "status",
      "variants"
    ],
    "additionalProperties": false
  }
}
