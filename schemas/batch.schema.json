{
  "$id":"batch.schema.json",
  "type":"object",
  "required":["jobs"],
  "additionalProperties":false,
  "properties":{"jobs":{"type":"array","minItems":1,"items":{
    "type":"object","required":["input"],"additionalProperties":false,
    "properties":{
      "input":{"type":"string","minLength":1},
      "format":{"enum":["html","svg","png","plan","fossflow"]},
      "output":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._-]*$"}
    }
  }}}
}
