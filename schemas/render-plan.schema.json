{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "render-plan.schema.json",
  "type": "object",
  "properties": {
    "scene_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "pixels_per_unit": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bounds": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "platform": {
      "type": "object",
      "properties": {
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "size",
        "height",
        "colors"
      ],
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "rotation": {
            "enum": [
              0,
              90,
              180,
              270
            ]
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "screen": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          }
        },
        "required": [
          "id",
          "asset_id",
          "rotation",
          "position",
          "scale",
          "screen",
          "rect",
          "box"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "scene_id",
    "pixels_per_unit",
    "bounds",
    "platform",
    "objects"
  ],
  "additionalProperties": false
}
